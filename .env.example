NOVICLOUD_ACCOUNT=
NOVICLOUD_PASSWORD=
NOVICLOUD_API_VERSION=v2
NOVICLOUD_BASE_URL=https://system.novicloud.pl/rest/api

MOYSKLAD_TOKEN=
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2

# Yandex Market Partner API. Do not commit a real .env file or paste keys into chat history.
YANDEX_MARKET_API_KEY=
YANDEX_MARKET_BUSINESS_ID=
YANDEX_MARKET_CAMPAIGN_ID=
# ^ comma-separated if syncing more than one campaign, e.g. 123,456,789
YANDEX_MARKET_BASE_URL=https://api.partner.market.yandex.ru

# Shopify Admin API — catalog/stock/order sync.
SHOPIFY_SHOP_DOMAIN=protsvetnoy.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Client/App secret — verifies the X-Shopify-Hmac-Sha256 signature on incoming webhooks.
SHOPIFY_API_SECRET=

# OZON Seller API — stock sync (Настройки → Seller API в личном кабинете seller.ozon.ru).
OZON_CLIENT_ID=
OZON_API_KEY=

# Make.com API — read-only, for inspecting scenarios before porting them.
MAKE_API_TOKEN=
MAKE_BASE_URL=https://eu1.make.com/api/v2

# Telegram bot — sends the Yandex Market/OZON shipping label after a new
# order creates a document in MoySklad and assembly is confirmed, and
# receives staff questions about an order for the Claude Q&A assistant (see
# ANTHROPIC_API_KEY below) — as a reply to the label, a reply to any other
# message mentioning the order, a plain order number, or a photo of a
# receipt/label. Inbound messages are read by telegram_qa_worker.py via
# long-polling (get_updates), not a webhook — Telegram's servers can't reach
# this Russian-hosted VPS on any inbound path, confirmed live: a registered
# webhook consistently failed with "Connection timed out" even though the
# service answered a direct external request instantly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LABEL_CHAT_ID=

# A separate bot/chat for the Claude-drafted replies to Yandex Market
# customer reviews and questions (kept apart from the order-assembly chat
# above). Not wired up yet — publishing the drafted reply still needs the
# Yandex Market API method confirmed against live data first.
TELEGRAM_REVIEWS_BOT_TOKEN=
TELEGRAM_REVIEWS_CHAT_ID=

# The VPS cannot reach api.telegram.org directly (blocked at the network
# level for Russian-hosted servers), so Telegram calls route through the
# telegram-proxy service (see Dockerfile.xray) — a VLESS client exposing a
# local SOCKS5 proxy, using VLESS over gRPC+Reality (the WS+TLS variant this
# provider also offers returns 403 Forbidden on the WebSocket handshake;
# gRPC+Reality is the one confirmed working). VLESS_* configure that
# sidecar's outbound connection; TELEGRAM_PROXY_URL points TelegramClient at
# it and is normally just socks5://telegram-proxy:1080 (the fixed in-network
# address), left empty to disable proxying (e.g. for local development where
# Telegram is reachable directly).
VLESS_UUID=
VLESS_HOST=
VLESS_PORT=
VLESS_SNI=
VLESS_PBK=
VLESS_SID=
TELEGRAM_PROXY_URL=

# Claude (Anthropic API) — drafts replies to warehouse-staff questions in the
# Telegram order chat and to Yandex Market reviews/questions. Get a key at
# console.anthropic.com. Both features simply don't run while this is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Keep read-only behavior enabled until production sync is verified.
DRY_RUN=true

# Separate switch for the MoySklad PL/LT/LV/EE shift-closing worker — it does
# not use DRY_RUN above, since that one gates sales/order sync which isn't
# production-ready yet. Set to false only once the detection log has been
# reviewed and looks right.
MOYSKLAD_SHIFT_CLOSE_DRY_RUN=true
