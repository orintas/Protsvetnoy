{
  "log": {"loglevel": "warning", "access": "", "error": ""},
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {"auth": "noauth", "udp": false}
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "__VLESS_HOST__",
            "port": __VLESS_PORT__,
            "users": [{"id": "__VLESS_UUID__", "encryption": "none", "flow": ""}]
          }
        ]
      },
      "streamSettings": {
        "network": "grpc",
        "security": "reality",
        "grpcSettings": {"serviceName": "", "multiMode": true},
        "realitySettings": {
          "serverName": "__VLESS_SNI__",
          "fingerprint": "chrome",
          "publicKey": "__VLESS_PBK__",
          "shortId": "__VLESS_SID__"
        }
      }
    }
  ]
}
